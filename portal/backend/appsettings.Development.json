{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=portal.db"
  },
  "Jwt": {
    "Key": "LocalDevSecretKeyAtLeast32CharactersLong!",
    "Issuer": "PrimusSaasPortal",
    "Audience": "PrimusSaasPortalUsers",
    "ExpiryInMinutes": 60
  },
  "AzureAd": {
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "SeedAdmin": {
    "Email": "admin@primussaas.local",
    "Password": "Admin123!"
  },
  "EmailSettings": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUser": "",
    "SmtpPass": "",
    "EnableSsl": false,
    "FromAddress": "dev@localhost",
    "DocsBaseUrl": "http://localhost:3000"
  },
  "Webhooks": {
    "NpmSecret": "dev-npm-secret",
    "NuGetSecret": "dev-nuget-secret",
    "RateLimitPerMinute": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {UserId} {TenantId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/portal-dev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {TraceId} {UserId} {TenantId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "PrimusPortal"
    }
  },
  "Telemetry": {
    "ApplicationInsightsConnectionString": "InstrumentationKey=22fe44f9-7950-4161-bb4e-704f17eabf67;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus.livediagnostics.monitor.azure.com/;ApplicationId=f2a8b80d-69aa-4f3a-9530-4ff6ae9b3280"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
