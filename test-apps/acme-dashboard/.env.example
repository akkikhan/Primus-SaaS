# ============================================
# PRIMUS APP ID (from Portal)
# ============================================
# This is your Primus Application ID - use it as the audience claim
# Get this from the Primus Portal after creating your application
API_AUDIENCE=PSP-CLI-XXXXXX

# ============================================
# AZURE AD CONFIGURATION (Production)
# ============================================
# Get these from Azure Portal → App registrations → Your app
AZURE_AD_ISSUER=https://login.microsoftonline.com/<YOUR_TENANT_ID>/v2.0
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/<YOUR_TENANT_ID>/v2.0

# Your Azure AD Application (client) ID
# This is DIFFERENT from the Primus App ID above
# This is used by MSAL.js in the frontend for login
AZURE_CLIENT_ID=<YOUR_AZURE_CLIENT_ID>

# ============================================
# LOCAL DEVELOPMENT (Optional)
# ============================================
LOCAL_ISSUER=http://localhost:4000
LOCAL_SECRET=local-dev-secret-min-32-chars

# ============================================
# NOTES
# ============================================
# - API_AUDIENCE: Primus App ID used as the "aud" claim in JWT tokens
# - AZURE_CLIENT_ID: Azure AD app registration ID (for frontend login)
# - These are TWO DIFFERENT values - don't confuse them!
# - Tokens must have: aud = <YOUR_PRIMUS_APP_ID> (e.g., PSP-CLI-711224)
