# Azure AD Configuration
# Get these values from Azure Portal → App registrations → Your app

# Azure AD Authority (tenant-specific or common)
# For single tenant: https://login.microsoftonline.com/YOUR-TENANT-ID
# For multi-tenant: https://login.microsoftonline.com/common
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common

# Azure AD Audience (your API's Application ID)
# This is the "Application (client) ID" from your Azure AD app registration
AZURE_AD_AUDIENCE=api://YOUR-AZURE-APP-ID

# Primus Portal Configuration (optional - for analytics)
# Get this from Primus Portal when you create your application
PRIMUS_TRACKING_ID=PSP-CLI-711224
PRIMUS_PORTAL_URL=http://localhost:5267
