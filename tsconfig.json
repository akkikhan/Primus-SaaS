{
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2020",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["portal/frontend/src/**/*"],
  "exclude": ["node_modules", "portal/backend/**"]
}
