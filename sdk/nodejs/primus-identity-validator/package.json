{
  "name": "@primus-saas/identity-validator",
  "version": "1.3.2",
  "description": "Multi-issuer JWT/OIDC token validator for Node.js. Supports Azure AD, custom JWT issuers, and any OIDC-compliant identity provider. Works with Express and NestJS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "jwt",
    "oidc",
    "authentication",
    "identity",
    "validator",
    "express",
    "nestjs",
    "azure-ad",
    "multi-tenant"
  ],
  "author": "Primus SaaS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/primus-saas/identity-validator"
  },
  "files": [
    "dist",
    "README.md",
    "TOKEN_GENERATION_GUIDE.md",
    "ERROR_REFERENCE.md",
    "PRODUCTION_DEPLOYMENT.md",
    "CHANGELOG.md",
    "TENANT_RESOLVER_GUIDE.md",
    "TESTING_GUIDE.md",
    "SECRET_MANAGEMENT.md",
    "CLAIMS_MAPPING.md",
    "ANGULAR_INTEGRATION.md",
    "DIAGNOSTICS_AND_TROUBLESHOOTING.md",
    "AZURE_AD_TROUBLESHOOTING.md",
    "AZURE_AD_END_TO_END.md",
    "REFRESH_GUIDE.md",
    "POLICY_HELPERS_SCOPE.md",
    "RELEASE_AND_ROADMAP.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.20",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "express": "^4.18.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
