    <description>Official .NET SDK for validating JWT tokens issued by Primus SaaS Portal. Provides middleware and extensions for ASP.NET Core applications to authenticate users.</description>
    <tags>primus-saas jwt authentication identity validator asp-net-core middleware</tags>
    <repository type="git" url="https://github.com/akkikhan/Primus-SaaS" />
    <dependencies>
      <group targetFramework="net7.0">
        <dependency id="Microsoft.AspNetCore.Authentication.JwtBearer" version="7.0.20" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="System.IdentityModel.Tokens.Jwt" version="8.14.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
