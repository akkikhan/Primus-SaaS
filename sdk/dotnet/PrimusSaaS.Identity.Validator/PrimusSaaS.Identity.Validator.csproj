<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(Net8SdkAvailable)' == 'true'">net6.0;net7.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Metadata -->
    <PackageId>PrimusSaaS.Identity.Validator</PackageId>
    <Version>1.3.5</Version>
    <Authors>Primus SaaS</Authors>
    <Company>Primus SaaS</Company>
    <Product>Primus SaaS Identity Validator</Product>
    <Description>Multi-issuer JWT/OIDC token validator for .NET 6.0, 7.0, and 8.0. Supports Azure AD, Auth0, AWS Cognito, Google, and custom JWT issuers. Features one-liner Auth0 setup with UseAuth0(), organization validation, M2M token support, and comprehensive claim mapping. Includes ASP.NET Core middleware and authorization extensions.</Description>
    <PackageTags>jwt;oidc;authentication;identity;validator;asp-net-core;azure-ad;auth0;cognito;multi-tenant</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/primus-saas/identity-validator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <PackageReleaseNotes>v1.3.5:
- DOCS: Comprehensive documentation update with accurate implementation examples and best practices.
- Improved developer experience with copy-paste ready code samples.

v1.3.4:
- FEATURE: Expose matched issuer/provider via HttpContext.GetMatchedIssuer() and inject provider claims for downstream responses.
- DOCS: Clarified Azure AD client_credentials issuer format (sts.windows.net) vs v2.0 and added guidance/examples.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="6.0.36" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.20" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="TOKEN_GENERATION_GUIDE.md" Pack="true" PackagePath="\" />
    <None Include="ERROR_REFERENCE.md" Pack="true" PackagePath="\" />
    <None Include="PRODUCTION_DEPLOYMENT.md" Pack="true" PackagePath="\" />
    <None Include="SECRET_MANAGEMENT.md" Pack="true" PackagePath="\" />
    <None Include="TESTING_GUIDE.md" Pack="true" PackagePath="\" />
    <None Include="CLAIMS_MAPPING.md" Pack="true" PackagePath="\" />
    <None Include="ANGULAR_INTEGRATION.md" Pack="true" PackagePath="\" />
    <None Include="TENANT_RESOLVER_GUIDE.md" Pack="true" PackagePath="\" />
    <None Include="DIAGNOSTICS_AND_TROUBLESHOOTING.md" Pack="true" PackagePath="\" />
    <None Include="AZURE_AD_TROUBLESHOOTING.md" Pack="true" PackagePath="\" />
    <None Include="AZURE_AD_END_TO_END.md" Pack="true" PackagePath="\" />
    <None Include="REFRESH_GUIDE.md" Pack="true" PackagePath="\" />
    <None Include="POLICY_HELPERS_SCOPE.md" Pack="true" PackagePath="\" />
    <None Include="RELEASE_AND_ROADMAP.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PrimusSaaS.Identity.Validator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
