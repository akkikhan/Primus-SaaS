<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>PrimusSaaS.Notifications</PackageId>
    <Version>1.4.2</Version>
    <Authors>Primus SaaS</Authors>
    <Company>Primus SaaS</Company>
    <Product>PrimusSaaS Notifications</Product>
    <Description>Notification building blocks for Primus SaaS apps: SMTP email delivery, SMS with Twilio/AWS SNS/Azure Communication Services, file-based templating, in-memory queueing, background dispatch, and diagnostics.</Description>
    <PackageTags>notifications;email;smtp;sms;twilio;aws-sns;azure-communication-services;templating;queue;background-services;aspnetcore;dotnet;primus-saas</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/primus-saas/notifications</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/primus-saas/notifications</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.4.2:
- E2E tested: All endpoint tests passing for email, SMS, and queue scenarios.
- Verified API accuracy: SmtpOptions (TimeoutSeconds, MaxRetryCount, RetryBaseDelayMs), NotificationResult.Channels.
- Production-ready with comprehensive copy-paste code samples.

v1.4.1:
- DOCS: Comprehensive documentation update with accurate implementation examples and best practices.
- Improved developer experience with copy-paste ready code samples for email, SMS, and templating.

v1.4.0: Added AWS SNS and Azure Communication Services as alternative SMS providers.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildProjectDirectory)\..\..\..\nupkg</PackageOutputPath>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.400.43" />
    <PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.401" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.17.5" />
    <PackageReference Include="Azure.Communication.Sms" Version="1.0.1" />
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="MailKit" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="7.0.0" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
    <PackageReference Include="Fluid.Core" Version="2.5.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="USAGE_GUIDE.md" Pack="true" PackagePath="\" />
    <None Include="TEMPLATE_GUIDE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
