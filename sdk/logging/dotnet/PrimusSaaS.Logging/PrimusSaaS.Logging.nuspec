<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>PrimusSaaS.Logging</id>
    <version>1.0.0</version>
    <title>PrimusSaaS Logging SDK</title>
    <authors>Primus SaaS</authors>
    <owners>Primus SaaS</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/primus-saas/logging</projectUrl>
    <description>Enterprise-grade structured logging library for .NET with PII masking, file rotation, async buffering, and Azure Application Insights integration. Fully compatible with Microsoft.Extensions.Logging.</description>
    <releaseNotes>
      v1.0.0:
      - Initial release
      - Structured JSON logging
      - Multiple output targets (Console, File, Application Insights)
      - PII masking with configurable patterns
      - File rotation and compression
      - Async buffering for high performance
      - Custom enrichers
      - Standard ILogger integration
      - ASP.NET Core middleware
    </releaseNotes>
    <copyright>Copyright © 2025 Primus SaaS</copyright>
    <tags>logging structured-logging aspnetcore pii-masking azure-insights enterprise</tags>
    <dependencies>
      <group targetFramework="net7.0">
        <dependency id="Microsoft.Extensions.Logging" version="7.0.0" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="7.0.0" />
        <dependency id="Microsoft.AspNetCore.Http.Abstractions" version="2.2.0" />
        <dependency id="Microsoft.ApplicationInsights.AspNetCore" version="2.21.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net7.0\PrimusSaaS.Logging.dll" target="lib\net7.0" />
    <file src="bin\Release\net7.0\PrimusSaaS.Logging.pdb" target="lib\net7.0" />
    <file src="README.md" target="" />
  </files>
</package>
