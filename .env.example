# Primus SaaS Platform - Environment Variables
# Copy this file to .env and configure your settings

# Database Connection
DB_CONNECTION_STRING=Server=localhost;Database=PrimusSaasPortal;Trusted_Connection=True;TrustServerCertificate=True

# JWT Configuration (minimum 32 characters for security)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Azure AD (Optional - for Azure AD authentication)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_AUDIENCE=your-audience-or-client-id

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5267/api

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your-email@example.com
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_ENABLE_SSL=true

# Webhook Secrets
WEBHOOK_NPM_SECRET=your-npm-webhook-secret
WEBHOOK_NUGET_SECRET=your-nuget-webhook-secret
