{
  "PrimusLogging": {
    "ApplicationId": "logging-advanced",
    "Environment": "Development",
    "MinLevel": 1,
    "Targets": [
      {
        "Type": "console",
        "Pretty": true
      },
      {
        "Type": "file",
        "Path": "logs/app.log",
        "Async": true,
        "MaxFileSize": 52428800,
        "MaxRetainedFiles": 7,
        "CompressRotatedFiles": true
      },
      {
        "Type": "applicationInsights",
        "ConnectionString": "InstrumentationKey=your-key"
      }
    ],
    "Pii": {
      "MaskEmails": true,
      "MaskCreditCards": true,
      "MaskSSN": true,
      "MaskPasswords": true,
      "MaskTokens": true,
      "MaskSecrets": true
    },
    "Sampling": {
      "Enabled": false,
      "SampleRate": 1.0,
      "AlwaysLogOnError": true
    },
    "TruncateCategoryNames": true,
    "MaxCategoryLength": 120
  }
}
