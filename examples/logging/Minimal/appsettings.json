{
  "PrimusLogging": {
    "ApplicationId": "logging-minimal",
    "Environment": "Development",
    "MinLevel": 1,
    "Targets": [
      {
        "Type": "console",
        "Pretty": true
      }
    ],
    "Pii": {
      "MaskEmails": true,
      "MaskCreditCards": true,
      "MaskSSN": true,
      "MaskPasswords": true,
      "MaskTokens": true,
      "MaskSecrets": true
    }
  }
}
