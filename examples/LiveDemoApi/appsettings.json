{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PrimusLogging": {
    "ApplicationId": "LiveDemoApi",
    "MinimumLevel": "Information",
    "RedactSensitiveData": true,
    "EnableScopes": true,
    "ApplicationInsights": {
      "Enabled": false,
      "ConnectionString": ""
    },
    "Targets": {
      "Console": { "Enabled": true },
      "File": {
        "Enabled": true,
        "Path": "logs/livedemo-api.log",
        "RollingInterval": "Day"
      }
    }
  },
  "PrimusIdentity": {
    "Issuers": [
      {
        "Name": "Auth0",
        "Type": "Auth0",
        "Issuer": "https://YOUR-TENANT.auth0.com/",
        "Authority": "https://YOUR-TENANT.auth0.com/",
        "Audiences": [ "https://your-api-identifier/" ],
        "AllowMachineToMachine": true,
        "AllowedGrantTypes": [
          "client_credentials",
          "client-credentials"
        ]
      },
      {
        "Name": "LocalJwt",
        "Type": "Jwt",
        "Issuer": "https://primus.local",
        "Audiences": [ "api://primus-livedemo" ],
        "Secret": "<set-in-user-secrets>"
      }
    ],
    "RequireHttpsMetadata": true
  },
  "DemoLocalAuth": {
    "Email": "demo@primus.local",
    "Password": "",
    "Name": "Primus Demo User",
    "Subject": "local-demo-user"
  },
  "Notifications": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true,
      "FromAddress": "",
      "FromName": "Primus Live Demo"
    },
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": "",
      "MessagingServiceSid": "",
      "ValidateOnStartup": false
    }
  },
  "PrimusFeatureFlags": {
    "Provider": "InMemory",
    "DefaultValue": false,
    "CacheDurationSeconds": 30,
    "Logging": {
      "LogEvaluations": true,
      "IncludeUserContext": false
    },
    "Flags": {
      "NewDashboard": {
        "Enabled": true,
        "Description": "Enable the new dashboard UI experience",
        "RolloutPercentage": 100
      },
      "BetaNotifications": {
        "Enabled": false,
        "Description": "Beta notification system with advanced templates",
        "RolloutPercentage": 25,
        "EnabledForGroups": [ "beta-testers", "admins" ]
      },
      "DarkMode": {
        "Enabled": true,
        "Description": "Enable dark mode UI theme"
      },
      "AdvancedAnalytics": {
        "Enabled": false,
        "Description": "Advanced analytics dashboard",
        "EnabledForUsers": [ "demo@primus.local" ]
      }
    }
  },
  "PrimusDocuments": {
    "Provider": "QuestPDF",
    "TempStoragePath": "temp/documents",
    "MaxContentLength": 20000,
    "LinkTtlMinutes": 10,
    "SelfTestEnabled": true,
    "TitleFontSize": 24,
    "BodyFontSize": 12,
    "IncludeFooter": true,
    "FooterText": "Generated by Primus Document Renderer"
  }
}
