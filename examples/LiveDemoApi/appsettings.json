{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PrimusIdentity": {
    "Issuers": [
      {
        "Name": "AzureAD",
        "Type": "Oidc",
        "Issuer": "https://login.microsoftonline.com/<YOUR_TENANT_ID>/v2.0",
        "Authority": "https://login.microsoftonline.com/<YOUR_TENANT_ID>/v2.0",
        "Audiences": [
          "api://<YOUR_API_CLIENT_ID>"
        ]
      },
      {
        "Name": "Auth0",
        "Type": "Oidc",
        "Issuer": "https://<YOUR_AUTH0_DOMAIN>.us.auth0.com/",
        "Authority": "https://<YOUR_AUTH0_DOMAIN>.us.auth0.com/",
        "Audiences": [
          "https://<YOUR_API_IDENTIFIER>"
        ]
      }
    ],
    "RequireHttpsMetadata": true
  }
}
