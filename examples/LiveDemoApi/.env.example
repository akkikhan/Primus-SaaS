# =============================================================================
# Primus SaaS LiveDemoApi - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets - this file (.env.example) is safe to commit.
# =============================================================================

# -----------------------------------------------------------------------------
# Identity (Issuer 0 - Azure AD)
# -----------------------------------------------------------------------------
PRIMUSIDENTITY__ISSUERS__0__NAME=AzureAD
PRIMUSIDENTITY__ISSUERS__0__TYPE=Oidc
PRIMUSIDENTITY__ISSUERS__0__ISSUER=https://sts.windows.net/<tenant-id>/
PRIMUSIDENTITY__ISSUERS__0__AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
PRIMUSIDENTITY__ISSUERS__0__AUDIENCES__0=api://<your-api-client-id>

# -----------------------------------------------------------------------------
# Identity (Issuer 1 - Auth0)
# -----------------------------------------------------------------------------
PRIMUSIDENTITY__ISSUERS__1__NAME=Auth0
PRIMUSIDENTITY__ISSUERS__1__TYPE=Oidc
PRIMUSIDENTITY__ISSUERS__1__ISSUER=https://<your-auth0-domain>.auth0.com/
PRIMUSIDENTITY__ISSUERS__1__AUTHORITY=https://<your-auth0-domain>.auth0.com/
PRIMUSIDENTITY__ISSUERS__1__AUDIENCES__0=https://<your-api-identifier>/
PRIMUSIDENTITY__ISSUERS__1__ALLOWMACHINETOMACHINE=true

# -----------------------------------------------------------------------------
# Identity (Issuer 2 - Local JWT for development)
# -----------------------------------------------------------------------------
PRIMUSIDENTITY__ISSUERS__2__NAME=LocalJwt
PRIMUSIDENTITY__ISSUERS__2__TYPE=Jwt
PRIMUSIDENTITY__ISSUERS__2__ISSUER=https://primus.local
PRIMUSIDENTITY__ISSUERS__2__AUDIENCES__0=api://primus-livedemo
PRIMUSIDENTITY__ISSUERS__2__SECRET=USE-DOTNET-USER-SECRETS-NOT-ENV-FILE

# -----------------------------------------------------------------------------
# Logging - Application Insights
# -----------------------------------------------------------------------------
PRIMUSLOGGING__APPLICATIONID=LiveDemoApi
PRIMUSLOGGING__MINIMUMLEVEL=Information
PRIMUSLOGGING__REDACTSENSITIVEDATA=true
PRIMUSLOGGING__APPLICATIONINSIGHTS__ENABLED=true
PRIMUSLOGGING__APPLICATIONINSIGHTS__CONNECTIONSTRING=USE-DOTNET-USER-SECRETS-NOT-ENV-FILE

# -----------------------------------------------------------------------------
# Logging - Targets
# -----------------------------------------------------------------------------
PRIMUSLOGGING__TARGETS__CONSOLE__ENABLED=true
PRIMUSLOGGING__TARGETS__FILE__ENABLED=true
PRIMUSLOGGING__TARGETS__FILE__PATH=logs/livedemo-api.log
PRIMUSLOGGING__TARGETS__FILE__ROLLINGINTERVAL=Day

# -----------------------------------------------------------------------------
# Notifications - SMTP (Email)
# -----------------------------------------------------------------------------
NOTIFICATIONS__SMTP__HOST=smtp.gmail.com
NOTIFICATIONS__SMTP__PORT=587
NOTIFICATIONS__SMTP__USERNAME=USE-DOTNET-USER-SECRETS-NOT-ENV-FILE
NOTIFICATIONS__SMTP__PASSWORD=USE-DOTNET-USER-SECRETS-NOT-ENV-FILE
NOTIFICATIONS__SMTP__ENABLESSL=true
NOTIFICATIONS__SMTP__FROMADDRESS=your-email@example.com
NOTIFICATIONS__SMTP__FROMNAME=Primus Live Demo

# -----------------------------------------------------------------------------
# Notifications - Twilio (SMS)
# -----------------------------------------------------------------------------
NOTIFICATIONS__TWILIO__ACCOUNTSID=USE-DOTNET-USER-SECRETS-NOT-ENV-FILE
NOTIFICATIONS__TWILIO__AUTHTOKEN=USE-DOTNET-USER-SECRETS-NOT-ENV-FILE
NOTIFICATIONS__TWILIO__FROMNUMBER=+1234567890
NOTIFICATIONS__TWILIO__VALIDATEONSTARTUP=false

# -----------------------------------------------------------------------------
# Demo Local Auth (Development Only)
# -----------------------------------------------------------------------------
DEMOLOCALAUTH__EMAIL=demo@primus.local
DEMOLOCALAUTH__PASSWORD=PrimusDemo123!
DEMOLOCALAUTH__NAME=Primus Demo User
DEMOLOCALAUTH__SUBJECT=local-demo-user

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
ASPNETCORE_URLS=http://localhost:5221
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
PRIMUSFEATUREFLAGS__PROVIDER=InMemory
PRIMUSFEATUREFLAGS__DEFAULTVALUE=false
PRIMUSFEATUREFLAGS__CACHEDURATIONSECONDS=30
PRIMUSFEATUREFLAGS__LOGGING__LOGEVALUATIONS=true
PRIMUSFEATUREFLAGS__LOGGING__INCLUDEUSERCONTEXT=false

# Feature: NewDashboard
PRIMUSFEATUREFLAGS__FLAGS__NEWDASHBOARD__ENABLED=true
PRIMUSFEATUREFLAGS__FLAGS__NEWDASHBOARD__DESCRIPTION=Enable the new dashboard UI experience
PRIMUSFEATUREFLAGS__FLAGS__NEWDASHBOARD__ROLLOUTPERCENTAGE=100

# Feature: BetaNotifications
PRIMUSFEATUREFLAGS__FLAGS__BETANOTIFICATIONS__ENABLED=false
PRIMUSFEATUREFLAGS__FLAGS__BETANOTIFICATIONS__DESCRIPTION=Beta notification system with advanced templates
PRIMUSFEATUREFLAGS__FLAGS__BETANOTIFICATIONS__ROLLOUTPERCENTAGE=25
PRIMUSFEATUREFLAGS__FLAGS__BETANOTIFICATIONS__ENABLEDFORGROUPS__0=beta-testers
PRIMUSFEATUREFLAGS__FLAGS__BETANOTIFICATIONS__ENABLEDFORGROUPS__1=admins

# Feature: DarkMode
PRIMUSFEATUREFLAGS__FLAGS__DARKMODE__ENABLED=true
PRIMUSFEATUREFLAGS__FLAGS__DARKMODE__DESCRIPTION=Enable dark mode UI theme

# Feature: AdvancedAnalytics
PRIMUSFEATUREFLAGS__FLAGS__ADVANCEDANALYTICS__ENABLED=false
PRIMUSFEATUREFLAGS__FLAGS__ADVANCEDANALYTICS__DESCRIPTION=Advanced analytics dashboard
PRIMUSFEATUREFLAGS__FLAGS__ADVANCEDANALYTICS__ENABLEDFORUSERS__0=demo@primus.local

# -----------------------------------------------------------------------------
# Document Renderer (Primus.Documents)
# -----------------------------------------------------------------------------
PRIMUSDOCUMENTS__PROVIDER=QuestPDF
PRIMUSDOCUMENTS__TEMPSTOREPATH=temp/documents
PRIMUSDOCUMENTS__MAXCONTENTLENGTH=20000
PRIMUSDOCUMENTS__LINKTTLMINUTES=10
PRIMUSDOCUMENTS__SELFTESTENABLED=true
