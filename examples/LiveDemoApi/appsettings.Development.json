{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PrimusLogging": {
    "ApplicationId": "LiveDemoApi",
    "MinimumLevel": "Debug",
    "RedactSensitiveData": true,
    "EnableScopes": true,
    "Targets": {
      "Console": { "Enabled": true },
      "File": {
        "Enabled": true,
        "Path": "logs/livedemo-api.log",
        "RollingInterval": "Day"
      }
    }
  }
}
