# Environment Configuration for Primus Auth Test App

# ============================================
# PRIMUS PORTAL CONFIGURATION (Required)
# ============================================
PRIMUS_PORTAL_URL=https://portal.primus-saas.com
PRIMUS_CLIENT_ID=your-application-client-id-here
PRIMUS_CLIENT_SECRET=your-client-secret-here

# ============================================
# VALIDATION MODE
# ============================================
# Options: Local, AzureAd, Hybrid
# - Local: Validates tokens using HMAC (HS256) signature with clientSecret
# - AzureAd: Validates tokens using Azure AD with RS256 signature
# - Hybrid: Tries Azure AD first, falls back to Local if validation fails
VALIDATION_MODE=Local

# ============================================
# AZURE AD CONFIGURATION (Required if mode is AzureAd or Hybrid)
# ============================================
AZURE_AD_TENANT_ID=your-azure-tenant-id-here
# Optional: JWKS cache TTL in hours (default: 24)
JWKS_CACHE_TTL=24

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5174

# ============================================
# EXAMPLES:
# ============================================

# Example 1: Local JWT Validation (HMAC)
# VALIDATION_MODE=Local
# PRIMUS_PORTAL_URL=https://portal.primus-saas.com
# PRIMUS_CLIENT_ID=abc123xyz
# PRIMUS_CLIENT_SECRET=super-secret-key-min-32-chars-required

# Example 2: Azure AD Validation (RS256)
# VALIDATION_MODE=AzureAd
# PRIMUS_PORTAL_URL=https://portal.primus-saas.com
# PRIMUS_CLIENT_ID=e2760fbd-f134-42f4-bcda-f44306fc3fe2
# PRIMUS_CLIENT_SECRET=your-secret
# AZURE_AD_TENANT_ID=cbd15a9b-cd52-4ccc-916a-00e2edb13043

# Example 3: Hybrid Mode (Try Azure AD, fallback to Local)
# VALIDATION_MODE=Hybrid
# PRIMUS_PORTAL_URL=https://portal.primus-saas.com
# PRIMUS_CLIENT_ID=e2760fbd-f134-42f4-bcda-f44306fc3fe2
# PRIMUS_CLIENT_SECRET=your-secret
# AZURE_AD_TENANT_ID=cbd15a9b-cd52-4ccc-916a-00e2edb13043
